{
  "name": "flex-attendance",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "docker compose down -v && docker compose up -d && node -e \"setTimeout(()=>{},6000)\" && npm run db:migrate && npm run db:seed",
    "db:check-access": "tsx db/access.check.ts",
    "db:close-periods": "tsx db/close-periods.ts",
    "verify": "npm run typecheck && npm run test && npm run build",
    "db:notify": "tsx db/notify-sync.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "luxon": "^3.7.2",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.2",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
